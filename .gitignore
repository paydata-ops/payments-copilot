# Secrets: holds the Anthropic API key. Never share.
.env

# Installed add-ons (anthropic, matplotlib, ...). Big, computer-specific, reinstallable.
.venv/

# Files Python creates by itself to start faster; regenerated automatically.
__pycache__/
*.pyc

# Generated data: recreate exactly with  python generate_data.py  (fixed seed).
transactions.db

# Page picture used only to check the exec-summary layout; the PDF is kept.
reports/*.png

# Personal Claude Code permission settings.
.claude/settings.local.json

# Excel lock files and Windows folder files.
~$*
Thumbs.db
desktop.ini

# Routing agent output (simulated changes and run records).
routing_changes.log
routing_agent_runs.log

# Routing agent test output.
routing_changes_test.log
routing_agent_test_runs.log
transactions_clean.db
